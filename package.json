{
    "name": "vdp-demo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "bundle": "rollup -c rollup.config.js",
        "zip": "zip -vr $(node -p \"Date.now()\").zip dist package.json index.js",
        "discard": "rimraf *.zip",
        "pack": "run-s discard bundle zip",
        "start:function": "node ./develop-function.js",
        "start:local": "node ./develop-local.js",
        "invoice": "run-p \"start:** invoice\"",
        "poster": "run-p \"start:** poster\"",
        "cv": "run-p \"start:** cv\"",
        "start": "npm run invoice"
    },
    "devDependencies": {
        "@google-cloud/functions-framework": "5.0.5",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-sucrase": "5.1.0",
        "@types/d3": "7.4.3",
        "@types/jsdom": "30.0.0",
        "@types/node": "26.6.1",
        "@types/react": "19.3.0",
        "chokidar": "5.0.0",
        "d3": "7.9.0",
        "npm-run-all": "4.1.5",
        "rimraf": "6.1.3",
        "rollup": "4.63.3",
        "rollup-plugin-copy": "3.5.0",
        "typescript": "*"
    },
    "dependencies": {
        "@react-pdf/renderer": "4.9.0",
        "axios": "1.20.0",
        "canvas": "3.2.3",
        "date-fns": "4.4.0",
        "jsdom": "30.1.0",
        "nanoid": "^6.0.1",
        "nanoid-dictionary": "^5.0.0",
        "qrcode": "1.5.3",
        "react": "*",
        "tree-kill": "^1.2.2",
        "tslib": "2.8.1"
    },
    "allowScripts": {
        "canvas@3.2.3": true,
        "fsevents@2.3.3": true
    }
}
